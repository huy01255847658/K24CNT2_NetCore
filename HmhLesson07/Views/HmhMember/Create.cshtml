@model HmhLesson07.Models.DataModels.HmhMember

@{
    ViewData["Title"] = "Create";
}

<div class="card p-3">
    <h1>Thêm mới thành viên</h1>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Create" method="post" asp-controller="HmhMember">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="HmhUserName" class="control-label"></label>
                    <input asp-for="HmhUserName" class="form-control" />
                    <span asp-validation-for="HmhUserName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="HmhPassword" class="control-label"></label>
                    <input asp-for="HmhPassword" class="form-control" />
                    <span asp-validation-for="HmhPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="HmhFullName" class="control-label"></label>
                    <input asp-for="HmhFullName" class="form-control" />
                    <span asp-validation-for="HmhFullName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="HmhEmail" class="control-label"></label>
                    <input asp-for="HmhEmail" class="form-control" />
                    <span asp-validation-for="HmhEmail" class="text-danger"></span>
                </div>
                <div class="form-group my-2">
                    <input type="submit" value="Ghi lại" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>

</div>