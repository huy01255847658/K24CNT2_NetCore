@model List<HmhBaiThucHanh03.Models.Book>

@{
    ViewData["Title"] = "Index";
}

<h2>Danh sách các cuốn sách</h2>

<!-- Hiển thị các combobox trên form -->
<form action="" method="post" class="form-inline" role="form">
    <select name="Authorid" class="form-control" asp-items="@ViewBag.authors">
        <option selected>Chọn tác giả</option>
    </select>
    <select name="Genreid" class="form-control" asp-items="@ViewBag.genres">
        <option selected>Chọn Thể loại</option>
    </select>
    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    <a asp-action="Create" class="btn btn-danger">Thêm mới</a>
</form>

<!-- Hiển thị danh sách các cuốn sách trên bảng html -->
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Tiêu đề</th>
            <th>Tác giả</th>
            <th>Thể loại</th>
            <th>Giá</th>
            <th>Hình ảnh</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Id</td>
                <td>@book.Title</td>
                <td>@book.AuthorId</td>
                <td>@book.GenreId</td>
                <td>@book.Price.ToString("#,##0") VNĐ</td>
                <td>
                    <img src="@book.Image" alt="@book.Title" width="40" />
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-primary">Sửa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
