@model HmhLesson08Lab.Models.HmhCategory

@{
    ViewData["Title"] = "Sửa Danh mục";
}

<h1>Sửa Danh mục</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="HmhEdit" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Tên danh mục</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">Cập nhật</button>
                <a asp-action="HmhIndex" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
