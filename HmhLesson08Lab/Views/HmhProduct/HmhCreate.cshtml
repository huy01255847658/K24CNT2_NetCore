@model HmhLesson08Lab.Models.HmhProduct

@{
    ViewData["Title"] = "Thêm Sản phẩm";
    var categories = ViewBag.Categories as List<HmhLesson08Lab.Models.HmhCategory>
                     ?? new List<HmhLesson08Lab.Models.HmhCategory>();
}

<h1>Thêm Sản phẩm mới</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="HmhCreate" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Tên sản phẩm</label>
                <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Price" class="form-label">Giá gốc (đ)</label>
                    <input asp-for="Price" class="form-control" type="number" min="0" step="1000" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SalePrice" class="form-label">Giá khuyến mãi (đ)</label>
                    <input asp-for="SalePrice" class="form-control" type="number" min="0" step="1000" />
                    <span asp-validation-for="SalePrice" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">Danh mục</label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">-- Chọn danh mục --</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Image" class="form-label">Hình ảnh (URL / tên file)</label>
                <input asp-for="Image" class="form-control" placeholder="Ví dụ: product.jpg hoặc https://..." />
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nhập mô tả sản phẩm..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="Status" class="form-check-input" type="checkbox" />
                    <label asp-for="Status" class="form-check-label">Còn hàng</label>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">Lưu</button>
                <a asp-action="HmhIndex" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
