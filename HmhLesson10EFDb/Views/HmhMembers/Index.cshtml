@model IEnumerable<HmhLesson10EFDb.Models.HmhMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.HmhUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HmhPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HmhFullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HmhEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HmhPhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HmhStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.HmhUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.HmhPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.HmhFullName)
            </td>
            <td>
                @Html.DisplayFor(model => item.HmhEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.HmhPhone)
            </td>
            <td>
                @Html.DisplayFor(model => item.HmhStatus)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
