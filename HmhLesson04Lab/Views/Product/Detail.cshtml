@model HmhLesson04Lab.Models.HmhProduct

@{
    ViewData["Title"] = "Chi tiết sản phẩm - " + Model.Name;
}

<div class="container my-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/san-pham" class="text-decoration-none">Sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <div class="row g-5 align-items-center">
                <div class="col-md-6 text-center">
                    <div class="p-3 bg-light rounded-4 border shadow-sm">
                        <img src="@Model.Image" alt="@Model.Name" class="img-fluid rounded-3" style="max-height: 400px; width: 100%; object-fit: contain;">
                    </div>
                </div>

                <div class="col-md-6">
                    <h2 class="fw-bold text-dark mb-3">@Model.Name</h2>

                    <div class="mb-4 p-3 bg-light rounded-3 d-inline-block w-100">
                        <div class="d-flex align-items-baseline gap-3">
                            <span class="text-muted text-decoration-line-through fs-5">@Model.Price.ToString("N0") đ</span>
                            <span class="text-danger fw-bold fs-2">@Model.SalePrice.ToString("N0") đ</span>
                            <span class="badge bg-danger fs-6 align-self-center">Tiết kiệm @((Model.Price - Model.SalePrice).ToString("N0")) đ</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <h6 class="fw-bold text-secondary">Mô tả sản phẩm:</h6>
                        <p class="text-muted fs-6 lh-base">@Model.Description</p>
                    </div>

                    <hr class="my-4">

                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <span class="fw-bold text-secondary d-block">Trạng thái:</span>
                            @if (Model.Status)
                            {
                                <span class="badge bg-success fs-6 mt-1 px-3 py-2">
                                    <i class="bi bi-check-circle me-1"></i> Còn hàng
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6 mt-1 px-3 py-2">
                                    <i class="bi bi-x-circle me-1"></i> Hết hàng
                                </span>
                            }
                        </div>
                        <div class="col-6">
                            <span class="fw-bold text-secondary d-block">Ngày đăng:</span>
                            <span class="text-dark fs-6 mt-1 d-inline-block">
                                <i class="bi bi-calendar3 me-1 text-primary"></i>
                                @Model.CreatedAt.ToString("dd/MM/yyyy hh:mm:ss tt")
                            </span>
                        </div>
                    </div>

                    <!-- Nút đỏ Về danh sách theo đúng Slide 19 -->
                    <div class="pt-2">
                        <a href="/san-pham" class="btn btn-danger btn-lg px-4 py-2 fw-bold rounded-3 shadow-sm">
                            <i class="bi bi-arrow-left me-2"></i>Về danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
