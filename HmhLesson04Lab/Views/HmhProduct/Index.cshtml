@model IEnumerable<HmhLesson04Lab.Models.HmhProduct>

@{
    ViewData["Title"] = "Danh sách sản phẩm - Hoàng Mạnh Huy";
    var categories = ViewBag.Categories as List<HmhLesson04Lab.Models.HmhCategory>;
    int? selectedCategoryId = ViewBag.SelectedCategoryId as int?;
}

<div class="container my-4">
    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white fw-bold py-3">
                    <i class="bi bi-list-ul me-2"></i>Danh mục sản phẩm
                </div>
                <div class="list-group list-group-flush rounded-bottom-3">
                    <a href="/san-pham" 
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(selectedCategoryId == null || selectedCategoryId == 0 ? "active bg-primary text-white fw-bold" : "")">
                        <span><i class="bi bi-grid-fill me-2"></i>Tất cả sản phẩm</span>
                    </a>
                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            bool isSelected = selectedCategoryId == cat.Id;
                            <a href="/san-pham?categoryId=@cat.Id" 
                               class="list-group-item list-group-item-action @(isSelected ? "active bg-primary text-white fw-bold" : "")">
                                <i class="bi bi-chevron-right me-1 small"></i> @cat.Name
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold text-dark m-0">
                    <i class="bi bi-bag-check text-primary me-2"></i>
                    @if (selectedCategoryId.HasValue && selectedCategoryId > 0 && categories != null)
                    {
                        var activeCat = categories.FirstOrDefault(c => c.Id == selectedCategoryId.Value);
                        @:Danh mục: @(activeCat?.Name ?? "Sản phẩm")
                    }
                    else
                    {
                        @:Danh sách sản phẩm
                    }
                </h3>
                <span class="badge bg-secondary fs-6">@Model.Count() sản phẩm</span>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info shadow-sm text-center py-5 rounded-3">
                    <i class="bi bi-info-circle fs-1 text-info d-block mb-2"></i>
                    Không tìm thấy sản phẩm nào trong danh mục này.
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                    @foreach (var product in Model)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0 product-card transition-all">
                                <div class="position-relative overflow-hidden rounded-top" style="background-color: #f8f9fa;">
                                    <img src="@product.Image" class="card-img-top p-3 img-fluid product-img" alt="@product.Name" style="height: 220px; object-fit: contain;">
                                    <span class="position-absolute top-0 start-0 bg-danger text-white px-2 py-1 m-2 rounded-2 fs-7 fw-bold">
                                        -@((int)((1 - product.SalePrice / product.Price) * 100))%
                                    </span>
                                </div>
                                <div class="card-body d-flex flex-column justify-content-between">
                                    <div>
                                        <h5 class="card-title fw-bold text-dark text-truncate" title="@product.Name">@product.Name</h5>
                                        <div class="mb-2">
                                            <span class="text-muted text-decoration-line-through me-2">@product.Price.ToString("N0") đ</span>
                                            <span class="text-danger fw-bold fs-5">@product.SalePrice.ToString("N0") đ</span>
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <a href="/san-pham/chi-tiet/@product.Id" class="btn btn-outline-primary w-100 fw-bold rounded-pill">
                                            <i class="bi bi-eye me-1"></i> Chi tiết
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
    .product-img {
        transition: transform 0.3s ease;
    }
    .product-card:hover .product-img {
        transform: scale(1.05);
    }
</style>
