<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HmhLesson06lab</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HmhLesson06lab.styles.css" asp-append-version="true" />
</head>
<body>
    @Html.Partial("_HmhHeader")

    <div class="container-fluid px-3">
        <div class="row mt-3">
            <div class="col-md-3 col-lg-2">
                @Html.Partial("~/Views/HmhPartials/_HmhCategoryPartial.cshtml")
            </div>
            <div class="col-md-9 col-lg-10">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    @Html.Partial("_HmhFooter")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
